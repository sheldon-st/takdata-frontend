# Backend base URL, inlined into the browser bundle at build time.
# Leave unset in production when the UI and /api share one host (requests
# go same-origin). Set it for local dev against a separate backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Where "Sign out" sends the user when the backend reports auth enabled
# (Authentik end-session URL for the TAK Manager application).
# NEXT_PUBLIC_SIGN_OUT_URL=https://auth.example.com/application/o/tak-manager/end-session/
